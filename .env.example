# Copy to .env and adjust. All keys are optional; defaults live in src/swarm_epi/config.py.

# OpenAI-compatible endpoint of the local inference server (vLLM in WSL2 by default).
LLM_BASE_URL=http://localhost:8000/v1
# Served model name (must match `vllm serve <name>`).
LLM_MODEL=cyankiwi/Qwen3.5-4B-AWQ-4bit
# vLLM ignores the key, the OpenAI client requires a non-empty string.
LLM_API_KEY=EMPTY
# Max concurrent requests sent to the server across all agents.
LLM_MAX_CONCURRENCY=48

# Where raw JSONL logs and per-run state go (WSL ext4 path recommended for speed).
RUNS_DIR=runs
# runs sub-directory used as pilot data for harvest, audits and Stage 2: pilot (default) or explore (deviation #13)
PILOT_BATCH=pilot
# Code-execution sandbox: "bwrap" (Linux, isolated) or "subprocess" (trusted code / unit tests only).
SANDBOX=bwrap
# Max parallel sandboxed executions.
SANDBOX_CONCURRENCY=12
